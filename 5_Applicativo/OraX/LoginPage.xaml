<?xml version="1.0" encoding="utf-8" ?>
    <ContentPage
    x:Class="OraX.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F2F2F7">

    <Grid>

       
        <VerticalStackLayout
            x:Name="LoginLayout"
            Padding="35"
            Spacing="20"
            VerticalOptions="Center"
            Opacity="0">

           
            <Label 
                Text="Login"
                FontSize="36"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="Black"/>

           
            <Border
                StrokeShape="RoundRectangle 18"
                Stroke="#E5E5EA"  
                BackgroundColor="White"
                Padding="0">

                <Entry
                    
                    FontFamily="font"
                    x:Name="UsernameEntry"
                    Placeholder="Username"
                    PlaceholderColor="#8E8E93"
                    FontSize="18"
                    TextColor="Black"
                    BackgroundColor="Transparent"
                    Margin="12,10"/>
            </Border>

            
            <Border
                StrokeShape="RoundRectangle 18"
                Stroke="#E5E5EA"
                BackgroundColor="White"
                Padding="0">

                <Entry
                    x:Name="PasswordEntry"
                    Placeholder="Password"
                    PlaceholderColor="#8E8E93"
                    IsPassword="True"
                    FontSize="18"
                    TextColor="Black"
                    BackgroundColor="Transparent"
                    Margin="12,10"/>
            </Border>

            
            <Button
                Text="Accedi"
                FontSize="18"
                HeightRequest="55"
                CornerRadius="18"
                BackgroundColor="#7C3AED"
                TextColor="White"
                Clicked="OnLoginClicked"/>

            
            <Label
                Text="Non hai un account? Registrati"
                FontSize="15"
                TextColor="#7C3AED"
                HorizontalOptions="Center">

                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRegisterTapped"/>
                </Label.GestureRecognizers>
            </Label>

        </VerticalStackLayout>

       
        <Image
            x:Name="IntroImage"
            Source="intro.png"
            Aspect="AspectFill"/>

    </Grid>

</ContentPage>