<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OraX.MainPage"
             BackgroundColor="#F7F7F7">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">

            <!-- PROFILE CARD -->
            <Frame CornerRadius="25"
                   Padding="25"
                   BackgroundColor="White"
                   HasShadow="False"
                   BorderColor="#EEEEEE">

                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">

                    <Frame WidthRequest="110"
                           HeightRequest="110"
                           CornerRadius="55"
                           IsClippedToBounds="True"
                           Padding="0"
                           BorderColor="#E6E6E6"
                           BackgroundColor="White"
                           HasShadow="False">

                        <Image Source="fox.jpg"
                               Aspect="AspectFill"/>
                    </Frame>

                    <Label Text="Mario Rossi"
                           FontSize="22"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#1C1C1E"/>

                    <Label Text="mario@email.com"
                           FontSize="14"
                           TextColor="#8E8E93"
                           HorizontalOptions="Center"/>

                </VerticalStackLayout>
            </Frame>

            <!-- STATISTICHE -->
            <Frame CornerRadius="25"
                   Padding="20"
                   BackgroundColor="White"
                   HasShadow="False"
                   BorderColor="#EEEEEE">

                <VerticalStackLayout Spacing="15">

                    <Label Text="Attività"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1C1C1E"/>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto">

                        <Label Text="Completate"
                               HorizontalOptions="Center"
                               TextColor="#8E8E93"/>

                        <Label Text="In sospeso"
                               Grid.Column="1"
                               HorizontalOptions="Center"
                               TextColor="#8E8E93"/>

                        <Label Text="25"
                               Grid.Row="1"
                               FontSize="22"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#34C759"/>

                        <Label Text="8"
                               Grid.Row="1"
                               Grid.Column="1"
                               FontSize="22"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#FF3B30"/>

                    </Grid>

                </VerticalStackLayout>
            </Frame>

            <!-- ACTIONS CARD -->
            <Frame CornerRadius="25"
                   Padding="10"
                   BackgroundColor="White"
                   HasShadow="False"
                   BorderColor="#EEEEEE">

                <VerticalStackLayout Spacing="0">

                    <!-- ITEM -->
                    <Button Text="Modifica profilo"
                            Clicked="Button_Clicked_1"
                            BackgroundColor="Transparent"
                            TextColor="#007AFF"
                            HorizontalOptions="Fill"
                            HeightRequest="50"/>

                    <BoxView HeightRequest="1"
                             Color="#E5E5EA"/>

                    <Button Text="Visualizza statistiche"
                            Clicked="Button_Clicked"
                            BackgroundColor="Transparent"
                            TextColor="#007AFF"
                            HeightRequest="50"/>

                    <BoxView HeightRequest="1"
                             Color="#E5E5EA"/>

                    <Button Text="Esci dal profilo"
                            BackgroundColor="Transparent"
                            TextColor="#FF3B30"
                            HeightRequest="50"/>

                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>