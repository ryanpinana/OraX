<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
             x:Class="OraX.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
           
            <controls:Calendar
                EventsScrollViewVisible="True"
                TodayFillColor="#512BD4"
                SelectedDayBackgroundColor="#2B0B98"
                SelectedDate="{Binding DataSelezionata}"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
