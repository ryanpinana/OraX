<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
             x:Class="OraX.CalendarPageV2"
             Title="CalendarPageV2">

    <!-- Grid generale -->
    <Grid>

        <!-- Contenuto della pagina -->
        <Grid RowDefinitions="Auto,*">

            <!-- Riga con nome utente -->
            <Grid Grid.Row="0" Padding="20,10">
                <HorizontalStackLayout
                    HorizontalOptions="End"
                    Spacing="10">

                    <Label Text="Nome Utente"
                           FontSize="16"
                           VerticalOptions="Center"/>

                    <Border StrokeShape="Ellipse"
                            WidthRequest="40"
                            HeightRequest="40">

                        <Image Source="dotnet_bot.png"
                               Aspect="AspectFill"/>
                    </Border>

                </HorizontalStackLayout>
            </Grid>


            <!-- Pagina principale -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="2*,3*"
                  Padding="20"
                  ColumnSpacing="30">

                <!-- Calendario -->
                <Frame Grid.Column="0"
                       CornerRadius="15"
                       Padding="10"
                       BackgroundColor="#F3F3F3">

                    <controls:Calendar
                        Events="{Binding EventiCalendario}"
                        EventIndicatorColor="Red"
                        EventsScrollViewVisible="True"
                        TodayFillColor="#512BD4"
                        SelectedDayBackgroundColor="#2B0B98"
                        SelectedDate="{Binding DataSelezionata}"/>

                </Frame>


                <!-- View degli eventi -->
                <VerticalStackLayout Grid.Column="1" Spacing="15">

                    <Label 
                        Text="Eventi del giorno"
                        FontSize="22"
                        FontAttributes="Bold"/>


                    <CollectionView ItemsSource="{Binding AttivitaDelGiorno}">

                        <CollectionView.ItemTemplate>

                            <DataTemplate>

                                <Frame BackgroundColor="{Binding Colore}"
                                       CornerRadius="12"
                                       Padding="15"
                                       Margin="0,5">

                                    <Label Text="{Binding Titolo}"
                                           TextColor="White"
                                           FontSize="16"/>

                                </Frame>

                            </DataTemplate>

                        </CollectionView.ItemTemplate>

                    </CollectionView>


                    <!-- Bottone d'aggiunta -->
                    <Button
                        Text="+ Aggiungi evento"
                        BackgroundColor="#512BD4"
                        TextColor="White"
                        CornerRadius="10"
                        HorizontalOptions="Start"
                        Padding="15,8"
                        Clicked="ApriOverlay"/>

                </VerticalStackLayout>

            </Grid>

        </Grid>


        <!-- Form overlay -->
        <Grid x:Name="Overlay"
              IsVisible="False"
              BackgroundColor="#80000000">

            <Frame
                BackgroundColor="White"
                CornerRadius="15"
                Padding="25"
                WidthRequest="350"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <VerticalStackLayout Spacing="15">

                    <Label 
                        Text="Nuova attività"
                        FontSize="22"
                        FontAttributes="Bold"/>

                    <Entry
                        x:Name="TitoloEntry"
                        Placeholder="Titolo attività"/>
                    

                    <Picker
                        x:Name="ColorePicker"
                        Title="Colore">

                        <Picker.Items>
                            <x:String>Rosso</x:String>
                            <x:String>Verde</x:String>
                            <x:String>Blu</x:String>
                        </Picker.Items>

                    </Picker>

                    <HorizontalStackLayout Spacing="10">

                        <Button
                            Text="Annulla"
                            Clicked="ChiudiOverlay"/>

                        <Button
                            Text="Aggiungi"
                            BackgroundColor="#512BD4"
                            TextColor="White"
                            Clicked="AggiungiAttivita"/>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Frame>

        </Grid>

    </Grid>

</ContentPage>