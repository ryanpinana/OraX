<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
             x:Class="OraX.CalendarPageV2"
             Title="CalendarPageV2">

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Padding="20,10">
            <HorizontalStackLayout
            HorizontalOptions="End"
            Spacing="10">

                <Label Text="Nome Utente" FontSize="16" VerticalOptions="Center"/>

                <Border StrokeShape="Ellipse"
                    WidthRequest="40"
                    HeightRequest="40"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Image Source="dotnet_bot.png"
                        Aspect="AspectFill"/>
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="2*,3*"
              Padding="20"
              ColumnSpacing="30">
            <Frame Grid.Column="0"
                   CornerRadius="15"
                   Padding="10"
                   BackgroundColor="#F3F3F3">
                
                <controls:Calendar
                    EventsScrollViewVisible="True"
                    TodayFillColor="#512BD4"
                    SelectedDayBackgroundColor="#2B0B98"/>
            </Frame>
            
            <VerticalStackLayout Grid.Column="1" Spacing="15">

                <Label 
                    Text="Eventi del giorno"
                    FontSize="22"
                    FontAttributes="Bold"/>


                <!-- Evento 1 -->
                <Frame BackgroundColor="#FF5C5C"
                       CornerRadius="12"
                       Padding="15">

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="📝" FontSize="20"/>
                        <Label Text="Verifica di Informatica"
                               TextColor="White"
                               FontSize="16"/>
                    </HorizontalStackLayout>

                </Frame>


                <!-- Evento 2 -->
                <Frame BackgroundColor="#7DBB5F"
                       CornerRadius="12"
                       Padding="15">

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="✈️" FontSize="20"/>
                        <Label Text="Vacanza Roma"
                               TextColor="White"
                               FontSize="16"/>
                    </HorizontalStackLayout>

                </Frame>


                <!-- Pulsante aggiungi -->
                <Button
                    Text="+ Aggiungi evento"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    CornerRadius="10"
                    HorizontalOptions="Start"
                    Padding="15,8"/>

            </VerticalStackLayout>
        </Grid>
        
    </Grid>

</ContentPage>