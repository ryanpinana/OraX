<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="OraX.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:OraX"
    Title="OraX">
    <TabBar>
    <ShellContent
        Title="Profilo"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    <ShellContent
        Title="Calendario"
        ContentTemplate="{DataTemplate local:Calendario}"
        Route="Calendario" />
    <ShellContent
        Title="Condivisa"
        ContentTemplate="{DataTemplate local:Condivisa}"
        Route="Condivisa" />
    </TabBar>

</Shell>
