<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
             x:Class="OraX.CalendarPageV2"
             Title="CalendarPageV2">

    <!-- Grid generale -->
    <Grid>

        <!-- Contenuto della pagina -->
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- HEADER -->
            <Grid Grid.Row="0"
          Padding="20,10"
          ColumnDefinitions="*,Auto,Auto">

                <SearchBar Grid.Column="0"
                   WidthRequest="900"
                   x:Name="SearchBarAttivita"
                   Placeholder="Cerca Attività..."
                   SearchButtonPressed="OnSearchPressed"
                   HeightRequest="55"
                   FontSize="18"
                   BackgroundColor="White"/>
                <Button Grid.Column="1"
                    Text="🔔"
                    WidthRequest="50"
                    HeightRequest="50"
                    CornerRadius="25"
                    BackgroundColor="#7B61FF"
                    TextColor="White"
                    Clicked="MostraRichiesteClicked"/>

                <HorizontalStackLayout
            Grid.Column="2"
            HorizontalOptions="End"
            Spacing="10">

                    <Label x:Name="LabelNomeUtente"
                   Text="Nome Utente"
                   FontSize="16"
                   VerticalOptions="Center"/>

                    <Border StrokeShape="Ellipse"
                    WidthRequest="40"
                    HeightRequest="40">

                        <Image Source="dotnet_bot.png"
                       Aspect="AspectFill"/>
                    </Border>

                </HorizontalStackLayout>
            </Grid>

            <!-- BARRA CALENDARI -->
            <Border
        Grid.Row="1"
        StrokeThickness="0"
        BackgroundColor="#1E1E1E"
        Padding="18"
        Margin="25,0,25,15"
        StrokeShape="RoundRectangle 25">

                <Grid
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="10">

                    <!-- PICKER -->
                    <Border
                Grid.Column="0"
                BackgroundColor="#2A2A2A"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 18">

                        <Picker
                    x:Name="CalendarioPicker"
                    Title="Calendario"
                    TextColor="White"
                    TitleColor="#AAAAAA"
                    FontSize="18"
                    Margin="15,0"
                    SelectedIndexChanged="CalendarioCambiato"/>
                    </Border>

                    <!-- CREA CALENDARIO -->
                    <Button
                Grid.Column="1"
                Text="+"
                FontSize="24"
                CornerRadius="22"
                BackgroundColor="#7B61FF"
                TextColor="White"
                HeightRequest="60"
                WidthRequest="60"
                Clicked="CreaCalendarioClicked"/>

                    <!-- INVITA -->
                    <Button
                Grid.Column="2"
                Text="👥"
                FontSize="18"
                CornerRadius="18"
                BackgroundColor="#3A3A3A"
                TextColor="White"
                HeightRequest="60"
                WidthRequest="60"
                Clicked="InvitaClicked"/>
                </Grid>
            </Border>
            


            <!-- Pagina principale -->
            <Grid Grid.Row="2"
                  ColumnDefinitions="1.2*,1*"
                  Padding="20"
                  ColumnSpacing="30">

                <!-- Calendario -->
                <Frame Grid.Column="0"
                       CornerRadius="15"
                       Padding="10"
                       BackgroundColor="#F3F3F3">

                    <controls:Calendar
                        Events="{Binding EventiCalendario}"
                        EventIndicatorColor="Red"
                        EventsScrollViewVisible="True"
                        TodayFillColor="#512BD4"
                        SelectedDayBackgroundColor="#2B0B98"
                        SelectedDate="{Binding DataSelezionata}"
                        FirstDayOfWeek="Monday"/>

                </Frame>


                <!-- View degli eventi -->
                <VerticalStackLayout Grid.Column="1" Spacing="15">

                    <Label 
                        Text="Eventi del giorno"
                        FontSize="22"
                        FontAttributes="Bold"/>


                    <CollectionView ItemsSource="{Binding AttivitaDelGiorno}"
                                    SelectionMode="Single"
                                    SelectionChanged="OnAttivitaSelezionata">

                        <CollectionView.ItemTemplate>

                            <DataTemplate>

                                <Grid ColumnDefinitions="*,Auto,Auto">

                                    <Frame Grid.Column="0"
                                           BackgroundColor="{Binding Colore}"
                                           CornerRadius="20"
                                           Padding="20"
                                           Margin="0,5">

                                        <Label Text="{Binding Titolo}"
                                               TextColor="White"
                                               FontSize="20"
                                               FontAttributes="Bold"/>

                                    </Frame>

                                    <Button Grid.Column="1"
                                            Text="✕"
                                            BackgroundColor="Transparent"
                                            FontSize="18"
                                            Clicked="EliminaAttivita"
                                            CommandParameter="{Binding .}"/> <!-- Passa l'oggetto Attivita al metodo -->

                                </Grid>
                            </DataTemplate>

                        </CollectionView.ItemTemplate>

                    </CollectionView>


                    <!-- Bottone d'aggiunta -->
                    <Button
                        Text="+ Aggiungi evento"
                        BackgroundColor="#512BD4"
                        TextColor="White"
                        CornerRadius="10"
                        HorizontalOptions="Start"
                        Padding="15,8"
                        Clicked="ApriOverlay"/>

                </VerticalStackLayout>

            </Grid>

        </Grid>


        <!-- Form overlay -->
        <Grid x:Name="Overlay"
              IsVisible="False"
              BackgroundColor="#80000000">

            <Frame
                BackgroundColor="White"
                CornerRadius="15"
                Padding="25"
                MaximumWidthRequest="550"
                MinimumWidthRequest="350"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <VerticalStackLayout Spacing="15">

                    <Label 
                        Text="Nuova attività"
                        FontSize="22"
                        FontAttributes="Bold"/>

                    <Entry
                        x:Name="TitoloEntry"
                        Placeholder="Titolo attività"/>
                    

                    <Picker
                        x:Name="ColorePicker"
                        Title="Colore">

                        <Picker.Items>
                            <x:String>Rosso</x:String>
                            <x:String>Verde</x:String>
                            <x:String>Blu</x:String>
                        </Picker.Items>

                    </Picker>

                    <Label Text="Data di fine" FontAttributes="Bold"/>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Attiva" VerticalOptions="Center"/>

                        <Switch x:Name="DataFineSwitch"
                                Toggled="OnDataFineSwitchToggled"/>
                    </HorizontalStackLayout>
                    
                    <DatePicker x:Name="DataFinePicker"
                                Format="dd/MM/yyyy"
                                IsEnabled="False"
                                Opacity="0.5"/>
                    <Label Text="Ora inizio" />
                    <TimePicker x:Name="OraInizioPicker"
                        Time="12:00" />
                    <Label Text="Ora fine" />
                    <TimePicker x:Name="OraFinePicker"
                        Time="13:00" />


                    <Picker
                        x:Name="TipoPicker"
                        Title="Tipo"
                        ItemsSource="{Binding tuttiTipi}"
                        ItemDisplayBinding="{Binding Nome}"/>

                    <Label
                        Text="Note"
                        FontAttributes="Bold"/>

                    <Editor
                        x:Name="NoteEditor"
                        Placeholder="Note dell'attività"
                        HeightRequest="100"/>

                    <HorizontalStackLayout Spacing="10">

                        <Button
                            Text="Annulla"
                            Clicked="ChiudiOverlay"/>

                        <Button
                            Text="Aggiungi"
                            BackgroundColor="#512BD4"
                            TextColor="White"
                            Clicked="AggiungiAttivita"/>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Frame>

        </Grid>

        <Grid x:Name="SearchOverlay"
              IsVisible="False"
              BackgroundColor="#80000000">

            <Frame BackgroundColor="White"
                   CornerRadius="15"
                   Padding="20"
                   MaximumWidthRequest="650"
                    MinimumWidthRequest="350"
                   HeightRequest="500"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">

                <Grid RowDefinitions="Auto,*">
                    
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">

                        <Label Text="Risultati ricerca"
                               FontSize="20"
                               FontAttributes="Bold"/>

                        <Button Grid.Column="1"
                                Text="✕"
                                BackgroundColor="Transparent"
                                Clicked="ChiudiSearchOverlay"/>
                    </Grid>
                    
                    <!-- Risultati -->
                    <CollectionView Grid.Row="1"
                                    ItemsSource="{Binding RisultatiRicerca}"
                                    SelectionMode="Single"
                                    SelectionChanged="OnRisultatoSelezionato">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Frame BackgroundColor="{Binding Colore}"
                                       CornerRadius="10"
                                       Padding="10"
                                       Margin="0,5">

                                    <VerticalStackLayout>
                                        <Label Text="{Binding Titolo}"
                                               TextColor="White"
                                               FontAttributes="Bold"/>

                                        <Label Text="{Binding Data, StringFormat='Inizio: {0:dd/MM/yyyy}'}"
                                               TextColor="White"
                                               FontSize="12"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Grid.Row="1"
                           Text="Nessuna attività trovata"
                           IsVisible="{Binding NessunRisultato}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           FontSize="16"/>
                </Grid>
            </Frame>
        </Grid>

        <Grid x:Name="OverlayDettaglio"
              IsVisible="False"
              BackgroundColor="#80000000">

            <Frame BackgroundColor="White"
                   CornerRadius="15"
                   Padding="0"
                   MaximumWidthRequest="550"
                    MinimumWidthRequest="350"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">

                <Grid RowDefinitions="120,Auto">
                    
                    <!-- Header con titolo -->
                    <Grid Grid.Row="0"
                          x:Name="DettaglioHeader"
                          RowDefinitions="*,Auto">

                        <Button Grid.Row="0"
                                Text="✕"
                                TextColor="White"
                                BackgroundColor="Transparent"
                                FontSize="20"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Clicked="ChiudiOverlayDettaglio"/>

                        <Label Grid.Row="1"
                               x:Name="DettaglioTitolo"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="White"
                               Margin="20,0,20,15"/>
                    </Grid>
                    <ScrollView>
                    <!-- Corpo informazioni -->
                    <VerticalStackLayout Grid.Row="1"
                                         Padding="20"
                                         Spacing="15">
                        
                        <!-- Data inizio -->
                        <VerticalStackLayout Spacing="3">
                            <Label Text="DATA INIZIO"
                                   FontSize="11"
                                   TextColor="Gray"
                                   FontAttributes="Bold"/>
                            <Label x:Name="DettaglioDataInizio"
                                   FontSize="16"/>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1"
                                 BackgroundColor="#EEEEEE"/>
                        
                        <!-- data fine -->
                        <VerticalStackLayout Spacing="3">
                            <Label Text="DATA FINE"
                                   FontSize="11"
                                   TextColor="Gray"
                                   FontAttributes="Bold"/>
                            <Label x:Name="DettaglioDataFine"
                                   FontSize="16"/>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1"
                                BackgroundColor="#EEEEEE"/>
                        
                        <!-- Colore -->
                        <VerticalStackLayout Spacing="3">
                            <Label Text="COLORE"
                                   FontSize="11"
                                   TextColor="Gray"
                                   FontAttributes="Bold"/>
                            <HorizontalStackLayout Spacing="10">
                                <BoxView x:Name="DettaglioColore"
                                         WidthRequest="20"
                                         HeightRequest="20"
                                         CornerRadius="10"
                                         VerticalOptions="Center"/>
                                <Label x:Name="DettaglioColoreNome"
                                       FontSize="16"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1"
                                 BackgroundColor="#EEEEEE"/>

                        <VerticalStackLayout Spacing="3">
                            <Label Text="TIPO"
                                   FontSize="11"
                                   TextColor="Gray"
                                   FontAttributes="Bold"/>

                            <Frame x:Name="DettaglioTipoTag"
                                   CornerRadius="20"
                                   Padding="12,5"
                                   HorizontalOptions="Start">

                                <Label x:Name="DettaglioTipoNome"
                                       TextColor="White"
                                       FontSize="14"
                                       FontAttributes="Bold"/>
                            </Frame>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1"
                            BackgroundColor="#EEEEEE"/>

                        <Label Text="NOTE"
                           FontSize="11"
                           TextColor="Gray"
                           FontAttributes="Bold"/>

                        <Label x:Name="DettaglioNote"
                               FontSize="14"/>
                    </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Frame>
        </Grid>

    </Grid>
        

</ContentPage>
    