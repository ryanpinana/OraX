<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
    x:Class="OraX.CalendarPageV2"
    Title="Calendario"
    BackgroundColor="#F5F3FF"
    Shell.NavBarIsVisible="False">

    <Grid>

        <Grid RowDefinitions="Auto,Auto,*">

            <!-- HEADER -->
            <Grid
                Grid.Row="0"
                Padding="25,25,25,10"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="15">

                <VerticalStackLayout Spacing="3">
                    <Label
                        Text="Calendario"
                        FontSize="32"
                        FontAttributes="Bold"
                        TextColor="#1F2937"/>

                    <Label
                        x:Name="LabelNomeUtente"
                        Text="Nome Utente"
                        FontSize="15"
                        TextColor="#6B7280"/>
                </VerticalStackLayout>

                <Button
                    Grid.Column="1"
                    ImageSource="campana.png"
                    WidthRequest="52"
                    HeightRequest="52"
                    CornerRadius="26"
                    BackgroundColor="#7C3AED"
                    TextColor="White"
                    FontSize="20"
                    Clicked="MostraRichiesteClicked"/>

            </Grid>

            <!-- SEARCH + CALENDARI -->
            <Border
                Grid.Row="1"
                Margin="20,5,20,15"
                Padding="18"
                BackgroundColor="White"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 28">

                <VerticalStackLayout Spacing="14">

                    <SearchBar
                        x:Name="SearchBarAttivita"
                        Placeholder="Cerca attività..."
                        SearchButtonPressed="OnSearchPressed"
                        HeightRequest="50"
                        FontSize="15"
                        BackgroundColor="#F3F4F6"/>

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">

                        <Border
                            Grid.Column="0"
                            BackgroundColor="#F3F4F6"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">

                            <Picker
                                x:Name="CalendarioPicker"
                                TextColor="#111827"
                                TitleColor="#6B7280"
                                FontSize="16"
                                Margin="12,0"
                                SelectedIndexChanged="CalendarioCambiato"/>
                        </Border>

                        <Button
                            Grid.Column="1"
                            Text="+"
                            FontSize="24"
                            CornerRadius="20"
                            BackgroundColor="#7C3AED"
                            TextColor="White"
                            HeightRequest="52"
                            WidthRequest="52"
                            Clicked="CreaCalendarioClicked"/>

                        <Button
                            Grid.Column="2"
                            ImageSource="people.jpg"
                            FontSize="18"
                            CornerRadius="20"
                            BackgroundColor="#EDE9FE"
                            TextColor="#7C3AED"
                            HeightRequest="52"
                            WidthRequest="52"
                            Clicked="InvitaClicked"/>
                    </Grid>

                </VerticalStackLayout>

            </Border>

            <!-- CONTENUTO -->
            <Grid
                Grid.Row="2"
                Padding="20,0,20,20"
                ColumnDefinitions="1.15*,0.85*"
                ColumnSpacing="20">

                <!-- CALENDARIO -->
                <Border
                    Grid.Column="0"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="15"
                    StrokeShape="RoundRectangle 30">

                    <controls:Calendar
                        Events="{Binding EventiCalendario}"
                        EventIndicatorColor="#7C3AED"
                        EventsScrollViewVisible="False"
                        TodayFillColor="#C4B5FD"
                        SelectedDayBackgroundColor="#7C3AED"
                        SelectedDate="{Binding DataSelezionata}"
                        FirstDayOfWeek="Monday"/>
                </Border>

                <!-- EVENTI -->
                <Border
                    Grid.Column="1"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="18"
                    StrokeShape="RoundRectangle 30">

                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="15">

                        <VerticalStackLayout Grid.Row="0" Spacing="3">
                            <Label
                                Text="Eventi del giorno"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="#1F2937"/>

                            <Label
                                Text="Le tue attività selezionate"
                                FontSize="13"
                                TextColor="#6B7280"/>
                        </VerticalStackLayout>

                        <CollectionView
                            Grid.Row="1"
                            ItemsSource="{Binding AttivitaDelGiorno}"
                            SelectionMode="Single"
                            SelectionChanged="OnAttivitaSelezionata">

                            <CollectionView.ItemTemplate>
                                <DataTemplate>

                                    <Border
                                        BackgroundColor="{Binding Colore}"
                                        StrokeThickness="0"
                                        Padding="15"
                                        Margin="0,5"
                                        StrokeShape="RoundRectangle 18">

                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">

                                            <Label
                                                Grid.Column="0"
                                                Text="{Binding Titolo}"
                                                TextColor="White"
                                                FontSize="16"
                                                FontAttributes="Bold"
                                                VerticalOptions="Center"/>

                                            <Button
                                                Grid.Column="1"
                                                Text="✎"
                                                BackgroundColor="#FFFFFF"
                                                TextColor="Black"
                                                CornerRadius="15"
                                                WidthRequest="34"
                                                HeightRequest="34"
                                                Padding="0"
                                                Clicked="ApriModificaAttivita"
                                                CommandParameter="{Binding .}"/>

                                            <Button
                                                Grid.Column="2"
                                                Text="✓"
                                                BackgroundColor="#FFFFFF"
                                                TextColor="Black"
                                                CornerRadius="15"
                                                WidthRequest="34"
                                                HeightRequest="34"
                                                Padding="0"
                                                Clicked="CompletaAttivita"
                                                CommandParameter="{Binding .}"/>

                                            <Button
                                                Grid.Column="3"
                                                Text="✕"
                                                BackgroundColor="#FFFFFF"
                                                TextColor="Black"
                                                CornerRadius="15"
                                                WidthRequest="34"
                                                HeightRequest="34"
                                                Padding="0"
                                                Clicked="EliminaAttivita"
                                                CommandParameter="{Binding .}"/>

                                        </Grid>
                                    </Border>

                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Button
                            Grid.Row="2"
                            Text="+ Aggiungi evento"
                            BackgroundColor="#7C3AED"
                            TextColor="White"
                            CornerRadius="18"
                            HeightRequest="50"
                            FontAttributes="Bold"
                            Clicked="ApriOverlay"/>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

        <!-- OVERLAY NUOVA / MODIFICA ATTIVITÀ -->
        <Grid
            x:Name="Overlay"
            IsVisible="False"
            BackgroundColor="#99000000">

            <Border
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="25"
                MaximumWidthRequest="560"
                MinimumWidthRequest="350"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                StrokeShape="RoundRectangle 28">

                <ScrollView>
                    <VerticalStackLayout Spacing="14">

                        <Label
                            x:Name="OverlayTitoloLabel"
                            Text="Nuova attività"
                            FontSize="26"
                            FontAttributes="Bold"
                            TextColor="#1F2937"/>

                        <Entry
                            x:Name="TitoloEntry"
                            Placeholder="Titolo attività"/>

                        <Label Text="Data inizio" FontAttributes="Bold"/>

                        <DatePicker
                            x:Name="DataInizioPicker"
                            Format="dd/MM/yyyy"/>

                        <Picker
                            x:Name="ColorePicker"
                            Title="Colore">

                            <Picker.Items>
                                <x:String>Rosso</x:String>
                                <x:String>Verde</x:String>
                                <x:String>Blu</x:String>
                            </Picker.Items>

                        </Picker>

                        <Label Text="Data di fine" FontAttributes="Bold"/>

                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Attiva" VerticalOptions="Center"/>

                            <Switch
                                x:Name="DataFineSwitch"
                                Toggled="OnDataFineSwitchToggled"/>
                        </HorizontalStackLayout>

                        <DatePicker
                            x:Name="DataFinePicker"
                            Format="dd/MM/yyyy"
                            IsEnabled="False"
                            Opacity="0.5"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                            <VerticalStackLayout>
                                <Label Text="Ora inizio"/>
                                <TimePicker
                                    x:Name="OraInizioPicker"
                                    Time="12:00"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Ora fine"/>
                                <TimePicker
                                    x:Name="OraFinePicker"
                                    Time="13:00"/>
                            </VerticalStackLayout>

                        </Grid>

                        <Picker
                            x:Name="TipoPicker"
                            Title="Tipo"
                            ItemsSource="{Binding tuttiTipi}"
                            ItemDisplayBinding="{Binding Nome}"/>

                        <Label Text="Note" FontAttributes="Bold"/>

                        <Editor
                            x:Name="NoteEditor"
                            Placeholder="Note dell'attività"
                            HeightRequest="100"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                            <Button
                                Text="Annulla"
                                BackgroundColor="#E5E7EB"
                                TextColor="#111827"
                                CornerRadius="16"
                                Clicked="ChiudiOverlay"/>

                            <Button
                                x:Name="SalvaAttivitaButton"
                                Grid.Column="1"
                                Text="Aggiungi"
                                BackgroundColor="#7C3AED"
                                TextColor="White"
                                CornerRadius="16"
                                Clicked="SalvaAttivitaClicked"/>

                        </Grid>

                    </VerticalStackLayout>
                </ScrollView>

            </Border>

        </Grid>

        <!-- OVERLAY RICERCA -->
        <Grid
            x:Name="SearchOverlay"
            IsVisible="False"
            BackgroundColor="#99000000">

            <Border
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="22"
                MaximumWidthRequest="650"
                MinimumWidthRequest="350"
                HeightRequest="500"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                StrokeShape="RoundRectangle 28">

                <Grid RowDefinitions="Auto,*" RowSpacing="15">

                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">

                        <Label
                            Text="Risultati ricerca"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="#1F2937"/>

                        <Button
                            Grid.Column="1"
                            Text="✕"
                            BackgroundColor="#F3F4F6"
                            TextColor="#111827"
                            CornerRadius="18"
                            WidthRequest="40"
                            HeightRequest="40"
                            Clicked="ChiudiSearchOverlay"/>
                    </Grid>

                    <CollectionView
                        Grid.Row="1"
                        ItemsSource="{Binding RisultatiRicerca}"
                        SelectionMode="Single"
                        SelectionChanged="OnRisultatoSelezionato">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Border
                                    BackgroundColor="{Binding Colore}"
                                    StrokeThickness="0"
                                    Padding="14"
                                    Margin="0,5"
                                    StrokeShape="RoundRectangle 16">

                                    <VerticalStackLayout>
                                        <Label
                                            Text="{Binding Titolo}"
                                            TextColor="White"
                                            FontAttributes="Bold"/>

                                        <Label
                                            Text="{Binding Data, StringFormat='Inizio: {0:dd/MM/yyyy}'}"
                                            TextColor="White"
                                            FontSize="12"/>
                                    </VerticalStackLayout>
                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label
                        Grid.Row="1"
                        Text="Nessuna attività trovata"
                        IsVisible="{Binding NessunRisultato}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        FontSize="16"
                        TextColor="#6B7280"/>

                </Grid>

            </Border>

        </Grid>

        <!-- OVERLAY DETTAGLIO -->
        <Grid
            x:Name="OverlayDettaglio"
            IsVisible="False"
            BackgroundColor="#99000000">

            <Border
                BackgroundColor="White"
                StrokeThickness="0"
                MaximumWidthRequest="550"
                MinimumWidthRequest="350"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                StrokeShape="RoundRectangle 28">

                <Grid RowDefinitions="120,*">

                    <Grid
                        Grid.Row="0"
                        x:Name="DettaglioHeader"
                        RowDefinitions="*,Auto"
                        Padding="15">

                        <HorizontalStackLayout
                            Grid.Row="0"
                            Spacing="8"
                            HorizontalOptions="End"
                            VerticalOptions="Start">

                            <Button
                                Text="✎"
                                TextColor="Black"
                                BackgroundColor="#FFFFFF"
                                CornerRadius="18"
                                WidthRequest="40"
                                HeightRequest="40"
                                Clicked="ModificaDaDettaglio"/>

                            <Button
                                Text="✕"
                            TextColor="Black"
                            BackgroundColor="#FFFFFF"
                            CornerRadius="18"
                            WidthRequest="40"
                            HeightRequest="40"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            Clicked="ChiudiOverlayDettaglio"/>

                        </HorizontalStackLayout>

                        <Label
                            Grid.Row="1"
                            x:Name="DettaglioTitolo"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="White"
                            Margin="5,0,5,5"/>
                    </Grid>

                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Padding="22" Spacing="15">

                            <VerticalStackLayout Spacing="3">
                                <Label Text="DATA INIZIO" FontSize="11" TextColor="#6B7280" FontAttributes="Bold"/>
                                <Label x:Name="DettaglioDataInizio" FontSize="16" TextColor="#111827"/>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" BackgroundColor="#E5E7EB"/>

                            <VerticalStackLayout Spacing="3">
                                <Label Text="DATA FINE" FontSize="11" TextColor="#6B7280" FontAttributes="Bold"/>
                                <Label x:Name="DettaglioDataFine" FontSize="16" TextColor="#111827"/>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" BackgroundColor="#E5E7EB"/>

                            <VerticalStackLayout Spacing="3">
                                <Label Text="COLORE" FontSize="11" TextColor="#6B7280" FontAttributes="Bold"/>

                                <HorizontalStackLayout Spacing="10">
                                    <BoxView
                                        x:Name="DettaglioColore"
                                        WidthRequest="20"
                                        HeightRequest="20"
                                        CornerRadius="10"
                                        VerticalOptions="Center"/>

                                    <Label
                                        x:Name="DettaglioColoreNome"
                                        FontSize="16"
                                        VerticalOptions="Center"
                                        TextColor="#111827"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" BackgroundColor="#E5E7EB"/>

                            <VerticalStackLayout Spacing="3">
                                <Label Text="TIPO" FontSize="11" TextColor="#6B7280" FontAttributes="Bold"/>

                                <Frame
                                    x:Name="DettaglioTipoTag"
                                    CornerRadius="20"
                                    Padding="12,5"
                                    HasShadow="False"
                                    HorizontalOptions="Start">

                                    <Label
                                        x:Name="DettaglioTipoNome"
                                        TextColor="White"
                                        FontSize="14"
                                        FontAttributes="Bold"/>
                                </Frame>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" BackgroundColor="#E5E7EB"/>

                            <Label Text="NOTE" FontSize="11" TextColor="#6B7280" FontAttributes="Bold"/>

                            <Label
                                x:Name="DettaglioNote"
                                FontSize="14"
                                TextColor="#111827"/>

                        </VerticalStackLayout>
                    </ScrollView>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</ContentPage>
