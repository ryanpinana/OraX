<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OraX.Modifiche"
             Title="Profilo"
             BackgroundColor="#F7F7F7"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="25">
            <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                <Frame x:Name="frameInizio"
                   HeightRequest="110"
                   WidthRequest="110"
                   CornerRadius="55"
                   Padding="0"
                   IsClippedToBounds="True"
                   BorderColor="#E6E6E6"
                   BackgroundColor="White"
                   HasShadow="False">
                    <Image x:Name="ImgProfilo"
                       Source="default_profile.png"
                       Aspect="AspectFill"/>
                </Frame>
                <Button Text="Cambia foto"
                    Clicked="OnChangePhotoClicked"
                    BackgroundColor="Transparent"
                    TextColor="#007AFF"
                    FontAttributes="Bold"/>

            </VerticalStackLayout>
            <Frame x:Name="frameInfo"
               CornerRadius="18"
               Padding="18"
               BackgroundColor="White"
               BorderColor="#EEEEEE"
               HasShadow="False">
                <VerticalStackLayout Spacing="18">
                    <Label x:Name="labelInfo"
                       Text="Informazioni personali"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#1C1C1E"/>
                    <Entry x:Name="NameEntry"
                       Placeholder="Nome"
                       BackgroundColor="#F2F2F7"
                       HeightRequest="45"/>
                    <Entry x:Name="SurnameEntry"
                       Placeholder="Cognome"
                       BackgroundColor="#F2F2F7"
                       HeightRequest="45"/>
                    <Entry x:Name="UsernameEntry"
                       Placeholder="Username"
                       BackgroundColor="#F2F2F7"
                       HeightRequest="45"/>
                </VerticalStackLayout>
            </Frame>
            <Frame x:Name="frameContatti"
               CornerRadius="18"
               Padding="18"
               BackgroundColor="White"
               BorderColor="#EEEEEE"
               HasShadow="False">
                <VerticalStackLayout Spacing="18">
                    <Label x:Name="labelContatti"
                       Text="Contatti"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#1C1C1E"/>
                    <Entry x:Name="EmailEntry"
                       Placeholder="Email"
                       Keyboard="Email"
                       BackgroundColor="#F2F2F7"
                       HeightRequest="45"/>
                    <Entry x:Name="PhoneEntry"
                       Placeholder="Telefono"
                       Keyboard="Telephone"
                       BackgroundColor="#F2F2F7"
                       HeightRequest="45"/>
                </VerticalStackLayout>
            </Frame>
            <Frame x:Name="frameExtra"
               CornerRadius="18"
               Padding="18"
               BackgroundColor="White"
               BorderColor="#EEEEEE"
               HasShadow="False">
                <VerticalStackLayout Spacing="18">
                    <Label x:Name="labelExtra"
                       Text="Extra"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#1C1C1E"/>
                    <Entry x:Name="BioEntry"
                       Placeholder="Bio (descrizione)"
                       HeightRequest="80"
                       BackgroundColor="#F2F2F7"/>
                    <DatePicker x:Name="BirthDatePicker"/>
                </VerticalStackLayout>
            </Frame>
            <Button Text="Salva modifiche"
                Clicked="OnSaveClicked"
                BackgroundColor="#007AFF"
                TextColor="White"
                CornerRadius="14"
                HeightRequest="50"
                FontAttributes="Bold"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
